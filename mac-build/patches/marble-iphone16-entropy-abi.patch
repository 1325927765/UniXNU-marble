--- a/osfmk/prng/entropy.c
+++ b/osfmk/prng/entropy.c
@@ -41,6 +41,12 @@
 #include <libkern/section_keywords.h>
 #include <sys/cdefs.h>
 
+/* Exact Apple XNU 8796 entropy ABI for the original iPhone corecrypto 12.
+ * Its native 256-bit conditioning, health tests and lazy crypto startup are
+ * retained. Counters observe the actual early/lazy paths only. */
+uint32_t marble_iphone16_entropy_early_requests;
+uint32_t marble_iphone16_entropy_lazy_initializations;
+
 // The number of samples we can hold in an entropy buffer.
 #define ENTROPY_MAX_SAMPLE_COUNT (2048)
 
@@ -90,10 +96,17 @@
 // Along with various counters and the buffer itself, this includes
