+
+void
+SHA1Update(SHA1_CTX *ctx, const void *data, size_t len)
+{
+	br_sha1_context br_ctx;
+
+	SHA1ToBr(ctx, &br_ctx);
+	br_sha1_update(&br_ctx, data, len);
+	BrToSHA1(&br_ctx, ctx);
+}
+
+void
+SHA1Final(void *digest, SHA1_CTX *ctx)
+{
+	br_sha1_context br_ctx;
+
+	SHA1ToBr(ctx, &br_ctx);
+	br_sha1_out(&br_ctx, digest);
+}
