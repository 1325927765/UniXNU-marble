+
+/*
+ * MARBLE crash report on the console. The phone has no way to get crash
+ * logs off the device, and corpses stop after a few crashes, so print what
+ * symbolication needs: user registers, a frame-pointer backtrace, the
+ * shared cache slide (unslid = pc - slide) and the main binary's Mach-O
+ * header (offset = pc - mh). Called from proc_prepareexit on the exiting
+ * (crashing) thread.
+ */
+void marble_crash_log(const char *name, int pid, int sig, uint64_t code, uint64_t subcode);
+static void marble_crash_strings(const char *name);
+
+void
+marble_crash_log(const char *name, int pid, int sig, uint64_t code, uint64_t subcode)
+{
+	int enabled = 0;
+	if (!PE_parse_boot_argn("marble_crash_log", &enabled, sizeof(enabled)) || !enabled) return;
+	thread_t thread = current_thread();
+	task_t task = current_task();
+	arm_saved_state_t *ss = find_user_regs(thread);
+	uint64_t slide = 0, mh = task->mach_header_vm_address;
+
+	vm_shared_region_t sr = vm_shared_region_get(task);
+	if (sr != NULL) {
+		slide = sr->sr_slide;
+		vm_shared_region_deallocate(sr);
+	}
+	printf("CRASH %s[%d] sig %d code 0x%llx sub 0x%llx slide 0x%llx mh 0x%llx\n",
+	    name, pid, sig, code, subcode, slide, mh);
+	if (ss == NULL || !is_saved_state64(ss)) {
+		return;
+	}
+	uint64_t fp = get_saved_state_fp(ss);
+	printf("CRASH %s pc 0x%llx lr 0x%llx sp 0x%llx fp 0x%llx far 0x%llx\n", name,
+	    get_saved_state_pc(ss), get_saved_state_lr(ss), get_saved_state_sp(ss), fp,
+	    (uint64_t)saved_state64(ss)->far);
+
+	char line[200];
+	int n = snprintf(line, sizeof(line), "CRASH %s bt", name);
+	for (int i = 0; i < 10 && fp != 0 && (fp & 7) == 0 && n < (int)sizeof(line) - 20; i++) {
+		uint64_t frame[2];
+		if (copyin((user_addr_t)fp, frame, sizeof(frame)) != 0) {
+			break;
+		}
+		n += snprintf(line + n, sizeof(line) - n, " 0x%llx", frame[1]);
+		if (frame[0] <= fp) {
+			break;
+		}
+		fp = frame[0];
+	}
+	printf("%s\n", line);
+	if ((sig == 6 && strcmp(name, "backboardd") == 0) ||
+	    (sig == 5 && strcmp(name, "watchdogd") == 0)) {
+		int scan = 0;
+		if (PE_parse_boot_argn("marble_crash_scan", &scan, sizeof(scan)) && scan) {
+			marble_crash_strings(name);
+		}
+	}
+}
+
+/* MARBLE_CRASH_STRING_SCAN */
+static void
+marble_crash_strings(const char *name)
+{
+	vm_map_t map = current_map();
+	vm_map_offset_t addr = 0;
+	uint64_t scanned = 0;
+	unsigned int lines = 0;
+	char *buf = kalloc_data(65536, Z_WAITOK);
+	if (buf == NULL) return;
+	printf("MARBLE STR scan %s\n", name);
+	while (lines < 96 && scanned < (96ull << 20)) {
+		vm_map_size_t size = 0;
+		natural_t depth = 0;
+		vm_region_submap_info_data_64_t info;
+		mach_msg_type_number_t count = VM_REGION_SUBMAP_INFO_V2_COUNT_64;
+		if (vm_map_region_recurse_64(map, &addr, &size, &depth,
+		    (vm_region_submap_info_64_t)&info, &count) != KERN_SUCCESS) break;
+		vm_map_offset_t base = addr;
+		addr += size;
+		if (info.is_submap || (info.protection & (VM_PROT_READ | VM_PROT_WRITE)) !=
+		    (VM_PROT_READ | VM_PROT_WRITE) || info.user_tag < 1 || info.user_tag > 11) continue;
+		for (vm_map_offset_t off = 0; off < size && lines < 96; off += 65536) {
+			size_t len = (size - off) < 65536 ? (size_t)(size - off) : 65536;
+			if (copyin((user_addr_t)(base + off), buf, len) != 0) continue;
+			scanned += len;
+			size_t start = 0;
+			for (size_t i = 0; i <= len; i++) {
+				bool ok = i < len && (unsigned char)buf[i] >= 0x20 && (unsigned char)buf[i] < 0x7f;
+				if (ok) continue;
+				size_t run = i - start;
+				if (run >= 16) {
+					char s[192];
+					size_t n = run < sizeof(s) - 1 ? run : sizeof(s) - 1;
+					memcpy(s, buf + start, n); s[n] = 0;
+					if (strnstr(s, "exception", n) || strnstr(s, "Exception", n) ||
+					    strnstr(s, "reason", n) || strnstr(s, "nil", n) || strnstr(s, "failed", n) ||
+					    strnstr(s, "Failed", n) || strnstr(s, "Error", n) ||
+					    strnstr(s, "container", n) || strnstr(s, "watchdog", n) ||
+					    strnstr(s, "IOService", n) || strnstr(s, "kext", n) ||
+					    strnstr(s, "discover", n) || strnstr(s, "open", n)) {
+						printf("MARBLE STR %s\n", s); lines++;
+					}
+				}
+				start = i + 1;
+			}
+		}
+	}
+	printf("MARBLE STR done %llu KiB %u lines\n", scanned >> 10, lines);
+	kfree_data(buf, 65536);
+}
+
+/* MARBLE_UI_SAMPLE_STACKS: 6 threads, 12 frames; no locks over reads/printf. */
+#include <mach/arm/thread_status.h>
+extern kern_return_t thread_get_state(thread_t, int, thread_state_t, mach_msg_type_number_t *);
+void marble_sample_task(const char *name, int pid, task_t task);
+void
+marble_sample_task(const char *name, int pid, task_t task)
+{
+    thread_t refs[6], thread;
+    unsigned count = 0;
+    uint64_t mh = 0, slide = 0;
+    vm_map_t map = get_task_map_reference(task);
+    if (map == VM_MAP_NULL) {
+        printf("MARBLE SMP %s[%d] inactive\n", name, pid);
+        return;
+    }
+    vm_shared_region_t sr = vm_shared_region_get(task);
+    if (sr != NULL) {
+        slide = sr->sr_slide;
+        vm_shared_region_deallocate(sr);
+    }
+    task_lock(task);
+    if (task->active) {
+        mh = task->mach_header_vm_address;
+        queue_iterate(&task->threads, thread, thread_t, task_threads) {
+            if (count == 6) break;
+            thread_reference(thread);
+            refs[count++] = thread;
+        }
+    }
+    task_unlock(task);
+    printf("MARBLE SMP %s[%d] slide=0x%llx mh=0x%llx threads=%u\n", name, pid, slide, mh, count);
+    for (unsigned i = 0; i < count; i++) {
+        arm_thread_state64_t state = {0};
+        mach_msg_type_number_t words = ARM_THREAD_STATE64_COUNT;
+        kern_return_t kr = thread_get_state(refs[i], ARM_THREAD_STATE64,
+            (thread_state_t)&state, &words);
+        thread_deallocate(refs[i]);
+        if (kr != KERN_SUCCESS || words != ARM_THREAD_STATE64_COUNT) {
+            printf("MARBLE SMP %s t%u state_error=%d\n", name, i, kr);
+            continue;
+        }
+        char line[400];
+        int n = snprintf(line, sizeof(line), "MARBLE SMP %s t%u pc=0x%llx lr=0x%llx sp=0x%llx bt",
+            name, i, state.pc, state.lr, state.sp);
+        uint64_t fp = state.fp;
+        for (unsigned j = 0; j < 12 && fp && !(fp & 7) && n < (int)sizeof(line)-21; j++) {
+            uint64_t frame[2];
+            if (fp > UINT64_MAX - sizeof(frame) ||
+                vm_map_read_user(map, fp, frame, sizeof(frame)) != KERN_SUCCESS) break;
+            n += snprintf(line+n, sizeof(line)-n, " 0x%llx", frame[1]);
+            if (frame[0] <= fp || frame[0]-fp > 1024*1024) break;
+            fp = frame[0];
+        }
+        printf("%s\n", line);
+    }
+    vm_map_deallocate(map);
+}
